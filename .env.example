# Copy this file to .env and fill it in. docker compose reads .env automatically; it is not committed.

# Your domain, exactly as set up in nginx proxy manager (comma-separate several). Required.
ALLOWED_HOSTS=loot.example.com

# Port on this machine that nginx proxy manager forwards to.
HOST_PORT=8080

# Image version: latest, a release like 0.1.0, or edge (newest build from main).
IMAGE_TAG=latest

# Who may set X-Forwarded-For. Empty = private and loopback ranges, which fits nginx proxy manager on the same
# machine. Narrow it to NPM's address if other devices on your network can reach HOST_PORT, e.g. 172.18.0.5
TRUSTED_PROXIES=

# A login expires after this many days without use.
SESSION_DAYS=30

# How much the server writes to its log (docker logs loot-gobbler):
#   info  = logins, registrations, admin actions and every sync (default)
#   debug = also every single request, with status, duration and IP
#   warn  = only problems (failed logins, wrong tokens, errors)
LOG_LEVEL=info
